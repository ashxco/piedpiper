#!/bin/sh
# pp-learnings-search — search learnings from prior sessions
# Usage: pp-learnings-search [--limit N] [--cross-project]

LIMIT=5
CROSS_PROJECT=false
DATA_DIR="$HOME/.piedpiper/advisors"

while [ $# -gt 0 ]; do
  case "$1" in
    --limit) LIMIT="$2"; shift 2 ;;
    --cross-project) CROSS_PROJECT=true; shift ;;
    *) shift ;;
  esac
done

REMOTE_URL=$(git config --get remote.origin.url 2>/dev/null || echo "")
if [ -n "$REMOTE_URL" ]; then
  SLUG=$(echo "$REMOTE_URL" | sed 's|.*[:/]||' | sed 's|\.git$||' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
else
  SLUG=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
fi

# Project-scoped learnings
[ -f "$DATA_DIR/projects/$SLUG/learnings.jsonl" ] && tail -n "$LIMIT" "$DATA_DIR/projects/$SLUG/learnings.jsonl" 2>/dev/null
for f in "$DATA_DIR/projects/$SLUG"/*.md; do [ -f "$f" ] && echo "--- $(basename "$f") ---" && tail -n 3 "$f" 2>/dev/null; done

# Global learnings
for f in "$DATA_DIR/learnings"/*.md; do [ -f "$f" ] && echo "--- $(basename "$f") ---" && tail -n 3 "$f" 2>/dev/null; done

# Cross-project
if [ "$CROSS_PROJECT" = true ]; then
  for d in "$DATA_DIR/projects"/*/; do
    p=$(basename "$d")
    [ "$p" = "$SLUG" ] && continue
    [ -f "${d}learnings.jsonl" ] && echo "--- $p ---" && tail -n 2 "${d}learnings.jsonl" 2>/dev/null
  done
fi
