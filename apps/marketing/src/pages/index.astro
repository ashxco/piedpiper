---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="hero">
    <img
      src="/piedpiper-overview.png"
      alt=""
      class="mascot"
      draggable="false"
    />
    <h1 class="title">Pied Piper</h1>
    <p class="description">
      A minimal GUI for coding agents. Manage projects, orchestrate AI
      workflows, and watch your team work from the office.
    </p>
  </section>

  <a href="https://github.com/ashxco/piedpiper" target="_blank" rel="noopener noreferrer" class="github-btn">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
    View on GitHub
  </a>

  <div class="screenshot-wrap">
    <img src="/piedpiper.png" alt="Pied Piper" class="screenshot" draggable="false" />
  </div>
</Layout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2vh 2rem 0;
  }

  .mascot {
    width: 340px;
    height: 340px;
    object-fit: contain;
    margin-bottom: -16px;
    opacity: 0;
    animation: fade-in 1s ease-out forwards;
  }

  .title {
    font-size: clamp(2.75rem, 6vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    background: linear-gradient(135deg, #e2e8f0, #ffffff, #94a3b8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    opacity: 0;
    animation: fade-in 1s ease-out 0.1s forwards;
  }


  .description {
    margin-top: 1.5rem;
    max-width: 480px;
    text-align: center;
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.55);
    opacity: 0;
    animation: fade-in 1s ease-out 0.3s forwards;
  }

  .github-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    padding: 0.6rem 1.4rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    transition: background 0.15s, border-color 0.15s;
    opacity: 0;
    animation: fade-in 1s ease-out 0.35s forwards;
  }

  .github-btn:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .screenshot-wrap {
    margin: 5vh auto 8vh;
    width: min(92vw, 1100px);
    opacity: 0;
    animation: fade-in 1s ease-out 0.4s forwards;
  }

  .screenshot {
    width: 100%;
    display: block;
    border-radius: 14px;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 2vh 1.5rem 0;
    }

    .mascot {
      width: 240px;
      height: 240px;
    }
  }
</style>
